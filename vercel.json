{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "daftarhub.app"
        }
      ],
      "destination": "https://www.daftarhub.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/compare/clickup-alternative", "destination": "/compare-clickup.html" },
    { "source": "/crewdesk/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/crewdesk", "destination": "/index.html" },
    { "source": "/crewdesk/:path*", "destination": "/:path*" }
  ]
}
